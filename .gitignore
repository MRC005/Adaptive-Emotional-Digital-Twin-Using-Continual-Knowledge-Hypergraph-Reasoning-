__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/
.DS_Store
.review2_staging/

# Run outputs are regenerable and are not committed, EXCEPT the
# presentation-ready set in figures/ and tables/, which is.
results/
# ---------------------------------------------------------------- data
# Raw participant data is NEVER committed: size, and no redistribution right.
# Only the provenance record (DOI, licence, per-file SHA-256) is tracked, so a
# run stays reproducible and citable without shipping anyone's data.
data/raw/*
!data/raw/*/
data/raw/*/**
!data/raw/*/PROVENANCE.json
data/interim/*
!data/interim/*/
data/interim/*/**
!data/interim/*/PROVENANCE.json
data/processed/*
data/synthetic/*
!data/**/.gitkeep

*.jsonl

# ---------------------------------------------------------------- frontend
node_modules/
